{
  "id": "/arcade-of-horror",
  "name": "Arcade of Horror",
  "short_name": "Horror Arcade",
  "description": "Eight Sonic Nova Studios horror arcade games in one installable mobile bundle.",
  "categories": ["games", "entertainment"],
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#060719",
  "theme_color": "#060719",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "./app-assets/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "./app-assets/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "./app-assets/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "./app-assets/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "./app-assets/icons/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./app-assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./app-assets/icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "./app-assets/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "./app-assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./app-assets/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./app-assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./hub-assets/background.webp",
      "sizes": "1672x941",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Arcade of Horror hub"
    }
  ],
  "shortcuts": [
    {
      "name": "Continue Last Game",
      "short_name": "Continue",
      "description": "Open Arcade of Horror and continue from the last cabinet.",
      "url": "./index.html#continue"
    },
    {
      "name": "Hell Climb",
      "short_name": "Hell Climb",
      "description": "Launch Hell Climb from the arcade shell.",
      "url": "./index.html#game/hell-climb"
    },
    {
      "name": "Flappy Bat",
      "short_name": "Flappy Bat",
      "description": "Launch Flappy Bat from the arcade shell.",
      "url": "./index.html#game/flappy-bat"
    },
    {
      "name": "Void Invaders",
      "short_name": "Invaders",
      "description": "Launch Void Invaders from the arcade shell.",
      "url": "./index.html#game/void-invaders"
    },
    {
      "name": "Undead Arena",
      "short_name": "Arena",
      "description": "Launch Undead Arena from the arcade shell.",
      "url": "./index.html#game/undead-arena"
    }
  ]
}
